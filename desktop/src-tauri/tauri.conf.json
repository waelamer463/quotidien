{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quotidien",
  "version": "1.0.0",
  "identifier": "fr.waelamer.quotidien",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "sh copy-web.sh",
    "beforeDevCommand": "sh copy-web.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Quotidien",
        "width": 1380,
        "height": 880,
        "minWidth": 960,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
