{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quotidien",
  "version": "1.0.0",
  "identifier": "fr.waelamer.quotidien",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "sh copy-web.sh",
    "beforeDevCommand": "sh copy-web.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Quotidien",
        "width": 1380,
        "height": 880,
        "minWidth": 960,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true
      },
      {
        "label": "widget",
        "url": "widget.html",
        "title": "Quotidien · widget",
        "width": 310,
        "height": 236,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true,
        "visibleOnAllWorkspaces": true,
        "windowEffects": {
          "effects": [
            "hudWindow"
          ],
          "state": "active",
          "radius": 22
        }
      },
      {
        "label": "quick",
        "url": "quick.html",
        "title": "Quotidien · vue rapide",
        "width": 640,
        "height": 178,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": true,
        "windowEffects": {
          "effects": [
            "hudWindow"
          ],
          "state": "active",
          "radius": 24
        }
      },
      {
        "label": "island",
        "url": "island.html",
        "title": "Quotidien · île",
        "width": 236,
        "height": 44,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}